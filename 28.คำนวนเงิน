import tkinter as tk
from tkinter import messagebox

def check_budget():
    try:
        budget = float(entry_budget.get())
        spent = float(entry_spent.get())

        if spent < budget:
            result_label.config(
                text=f"💰 ใช้น้อยกว่างบ\nเหลือ {budget - spent:.2f} บาท 🎉",
                fg="#2E8B57"
            )
        elif spent == budget:
            result_label.config(
                text="😄 ใช้พอดีกับงบเป๊ะเลย!",
                fg="#1E90FF"
            )
        else:
            result_label.config(
                text=f"⚠️ ใช้เกินงบ\nเกิน {spent - budget:.2f} บาท 😢",
                fg="#DC143C"
            )
    except ValueError:
        messagebox.showerror("Error", "กรุณาใส่ตัวเลขเท่านั้นนะคะ 💕")

# ===== หน้าต่างหลัก =====
root = tk.Tk()
root.title("🌷 โปรแกรมตรวจสอบการใช้เงิน 🌷")
root.geometry("380x320")
root.configure(bg="#FFE4E1")

# ===== ฟอนต์ =====
title_font = ("Comic Sans MS", 16, "bold")
label_font = ("Comic Sans MS", 11)
button_font = ("Comic Sans MS", 11, "bold")

# ===== หัวข้อ =====
tk.Label(
    root,
    text="🌷 โปรแกรมตรวจสอบการใช้เงิน 🌷",
    font=title_font,
    bg="#FFE4E1",
    fg="#D6336C"
).pack(pady=10)

# ===== งบประมาณ =====
tk.Label(
    root,
    text="งบประมาณ (บาท)",
    font=label_font,
    bg="#FFE4E1"
).pack()

entry_budget = tk.Entry(root, font=label_font, justify="center")
entry_budget.pack(pady=5)

# ===== ใช้ไปแล้ว =====
tk.Label(
    root,
    text="ใช้ไปแล้ว (บาท)",
    font=label_font,
    bg="#FFE4E1"
).pack()

entry_spent = tk.Entry(root, font=label_font, justify="center")
entry_spent.pack(pady=5)

# ===== ปุ่ม =====
tk.Button(
    root,
    text="✨ ตรวจสอบ ✨",
    font=button_font,
    bg="#FFB6C1",
    fg="white",
    command=check_budget
).pack(pady=15)

# ===== แสดงผล =====
result_label = tk.Label(
    root,
    text="",
    font=label_font,
    bg="#FFF0F5",
    width=35,
    height=4,
    relief="ridge"
)
result_label.pack(pady=10)

root.mainloop()
