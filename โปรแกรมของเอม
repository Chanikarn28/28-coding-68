# โปรแกรมตรวจสอบการใช้เงิน

# รับค่าจากผู้ใช้
budget = float(input("กรุณาใส่งบประมาณของคุณ (บาท): "))
spent = float(input("กรุณาใส่จำนวนเงินที่ใช้ไป (บาท): "))

# เปรียบเทียบงบประมาณกับเงินที่ใช้
if spent < budget:
    print("คุณใช้เงินน้อยกว่างบประมาณ")
    print(f"เหลือเงิน {budget - spent:.2f} บาท")
elif spent == budget:
    print("คุณใช้เงินพอดีกับงบประมาณ")
else:
    print("คุณใช้เงินมากกว่างบประมาณ")
    print(f"ใช้เกินงบ {spent - budget:.2f} บาท")

